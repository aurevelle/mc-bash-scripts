wait || true

cube_reveal=()
for ((ci = 0; ci < ${#cube_targets[@]}; ci++)); do
    cube_reveal[$ci]=""
    case ${cube_targets[ci]} in
        *api.urchin.gg*) ;;
        *) continue ;;
    esac
    [ "$(cat "$tmpd/cube$ci.code" 2>/dev/null)" = 200 ] || continue
    hidden=$(jq -r '[.tags[]? | select(((.tooltip // "") | test("Added [^)]*\\)")) and ((.tooltip // "") | test("Added by ") | not))] | length' \
        "$tmpd/cube$ci.json" 2>/dev/null) || hidden=0
    [ "${hidden:-0}" -gt 0 ] 2>/dev/null || continue
    reveal_url=$(printf '%s' "${cube_targets[ci]}" | sed 's|/cubelify|/player/tags|')
    reveal_url=$(printf '%s' "$reveal_url" | sed -E 's/([?&])reveal_hidden=[^&]*//')
    reveal_url=${reveal_url%[?&]}
    case $reveal_url in
        *\?*) reveal_url="$reveal_url&reveal_hidden=true" ;;
        *) reveal_url="$reveal_url?reveal_hidden=true" ;;
    esac
    code=$(curl -sS --max-time 20 -A "$ua" -o "$tmpd/reveal$ci.json" -w '%{http_code}' \
        "$reveal_url" 2>/dev/null) || code=000
    [ "$code" = 200 ] || continue
    jq -r '.tags[]? | select((.added_by_username // "") != "") |
        [((.tag_type // "") | gsub("_"; " ") | ascii_downcase | split(" ") | map((.[0:1] | ascii_upcase) + .[1:]) | join(" ")), .added_by_username] |
        join("\u001f")' "$tmpd/reveal$ci.json" >"$tmpd/reveal$ci.tsv" 2>/dev/null || true
    [ -s "$tmpd/reveal$ci.tsv" ] && cube_reveal[$ci]="$tmpd/reveal$ci.tsv"
done

if [ -n "$api_key" ]; then
    if [ "$(cat "$tmpd/hypixel.code" 2>/dev/null)" = 200 ]; then
        read_api "$tmpd/hypixel.json" || true
    else
        api_err="hypixel api unreachable (HTTP $(cat "$tmpd/hypixel.code" 2>/dev/null))"
    fi
fi

if [ "$(cat "$tmpd/forums.code" 2>/dev/null)" = 200 ]; then
    parse_forums "$tmpd/forums" || DSTATE=unknown
else
    DSTATE=unknown
fi

skin_url=""
if [ "$(cat "$tmpd/profile.code" 2>/dev/null)" = 200 ]; then
    b64=$(jq -r '.properties[]? | select(.name == "textures") | .value' "$tmpd/profile.json" 2>/dev/null | head -n1 || true)
    if [ -n "$b64" ]; then
        tex_json=$(printf '%s' "$b64" | base64 -d 2>/dev/null | tr -d '\r\n' || true)
        skin_url=$(printf '%s' "$tex_json" |
            sed -n 's|.*"SKIN"[[:space:]]*:[[:space:]]*{[^}]*"url"[[:space:]]*:[[:space:]]*"\([^"]*\)".*|\1|p' |
            sed 's|^http://|https://|')
    fi
fi

if [ -n "$skin_url" ]; then
    if curl -fsS --max-time 20 -o "$tmpd/skin.png" "$skin_url" 2>/dev/null; then
        render_head "$tmpd/skin.png" || true
    else
        note "could not download the skin"
    fi
fi

TEXT=()

TEXT+=("${RANK_TAG}$(bold "$(paint "$C_NAME" "$name")")")
TEXT+=("$(paint "$C_UUID" "$uuid")")
TEXT+=("")

TEXT+=("$(hdr "$C_HDR" blacklists)")
if [ "${#cube_targets[@]}" -eq 0 ]; then
    TEXT+=("  $(paint "$C_DIM" "none set")  $(paint "$C_DIM" "--cubelify <url> [name]")")
else
    for ((ci = 0; ci < ${#cube_targets[@]}; ci++)); do
        cube_label=${cube_labels[ci]}
        cube_code=$(cat "$tmpd/cube$ci.code" 2>/dev/null)
        if [ "$cube_code" != 200 ]; then
            TEXT+=("  $(chip "$cube_label" "HTTP $cube_code" "$C_BAD")")
            continue
        fi
        cube_score=$(jq -r '(.score.value // empty) | tonumber? // empty | floor' "$tmpd/cube$ci.json" 2>/dev/null) || cube_score=
        cube_tags=$(jq -r '.tags | length' "$tmpd/cube$ci.json" 2>/dev/null) || cube_tags=0
        cube_tags=${cube_tags:-0}
        if [ -z "$cube_score" ]; then
            TEXT+=("  $(chip "$cube_label" "unreadable" "$C_BAD")")
            continue
        fi
        if [ "$cube_score" -ge 50 ]; then
            score_color=$C_BAD
        elif [ "$cube_score" -ge 15 ]; then
            score_color=$C_WARN
        else
            score_color=$C_GOOD
        fi
        TEXT+=("  $(chip "$cube_label" "score $cube_score" "$score_color")   $(chip tags "$cube_tags")")
        if [ "$cube_tags" -eq 0 ]; then
            TEXT+=("    $(paint "$C_GOOD" "no tags")")
        else
            shown=0
            while IFS=$'\x1f' read -r tag_color tag_text; do
                [ -n "$tag_text" ] || continue
                shown=$(( shown + 1 ))
                if [ "$shown" -gt 4 ]; then
                    TEXT+=("    $(paint "$C_DIM" "… $(( cube_tags - 4 )) more")")
                    break
                fi
                if ! [ "${tag_color:-0}" -gt 0 ] 2>/dev/null; then
                    tag_color=$C_LABEL
                fi
                tag_text=${tag_text//$'\x1e'/$'\n'}
                if [ -n "${cube_reveal[$ci]:-}" ] && [ -f "${cube_reveal[$ci]}" ]; then
                    tag_head=${tag_text%%$'\n'*}
                    tag_rest=""
                    [ "$tag_head" = "$tag_text" ] || tag_rest=${tag_text#*$'\n'}
                    while IFS=$'\x1f' read -r rv_title rv_user; do
                        [ -n "$rv_title" ] && [ -n "$rv_user" ] || continue
                        case $tag_head in
                            *"Added by "*) break ;;
                            *"$rv_title"*) ;;
                            *) continue ;;
                        esac
                        tag_head=$(printf '%s' "$tag_head" | sed -E "s/\\(Added ([^)]*)\\)/(Added by $rv_user \\1)/")
                        break
                    done <"${cube_reveal[$ci]}"
                    if [ -n "$tag_rest" ]; then
                        tag_text="$tag_head"$'\n'"$tag_rest"
                    else
                        tag_text=$tag_head
                    fi
                fi
                first=1
                while IFS= read -r tag_line; do
                    [ -n "$tag_line" ] || continue
                    if [ "$first" -eq 1 ]; then
                        TEXT+=("    $(paint "$tag_color" '•') $(paint "$tag_color" "$tag_line")")
                        first=0
                    else
                        TEXT+=("      $(paint "$tag_color" "$tag_line")")
                    fi
                done <<<"$tag_text"
            done < <(jq -r '.tags[]? | [(((.color // 0) | tonumber? // 0) | floor), ((.tooltip // "") | gsub("\n"; "\u001e"))] | join("\u001f")' \
                "$tmpd/cube$ci.json" 2>/dev/null)
        fi
    done
fi

TEXT+=("")

if [ -z "$api_key" ]; then
    TEXT+=("$(hdr "$C_HDR" hypixel)")
    TEXT+=("  $(paint "$C_DIM" "no api key set")  $(paint "$C_DIM" "--key <key>")")
elif [ "$api_ok" -eq 0 ]; then
    TEXT+=("$(hdr "$C_HDR" hypixel)")
    TEXT+=("  $(paint "$C_BAD" "$api_err")")
else
    TEXT+=("$(hdr "$C_BW" bedwars)  $(paint "$C_BW" "★ $(bw_level "$bw_xp")")")
    TEXT+=("  $(chip wins "$(commas "$bw_wins")")   $(chip losses "$(commas "$bw_losses")")   $(chip wlr "$(ratio "$bw_wins" "$bw_losses")")")
    TEXT+=("  $(chip 'final kills' "$(commas "$bw_fk")")   $(chip 'final deaths' "$(commas "$bw_fd")")   $(chip fkdr "$(ratio "$bw_fk" "$bw_fd")")")
    TEXT+=("  $(chip beds "$(commas "$bw_beds")")   $(chip winstreak "$(commas "$bw_ws")")")
    TEXT+=("")

    TEXT+=("$(hdr "$C_SW" skywars)")
    TEXT+=("  $(chip wins "$(commas "$sw_wins")")   $(chip losses "$(commas "$sw_losses")")   $(chip wlr "$(ratio "$sw_wins" "$sw_losses")")")
    TEXT+=("  $(chip kills "$(commas "$sw_kills")")   $(chip deaths "$(commas "$sw_deaths")")   $(chip kdr "$(ratio "$sw_kills" "$sw_deaths")")")
    TEXT+=("")

    TEXT+=("$(hdr "$C_DUEL" duels)")
    TEXT+=("  $(chip wins "$(commas "$du_wins")")   $(chip losses "$(commas "$du_losses")")   $(chip wlr "$(ratio "$du_wins" "$du_losses")")")
    TEXT+=("  $(chip kills "$(commas "$du_kills")")   $(chip deaths "$(commas "$du_deaths")")   $(chip kdr "$(ratio "$du_kills" "$du_deaths")")")
    TEXT+=("  $(chip winstreak "$(commas "$du_ws")")   $(chip best "$(commas "$du_best")")")
    TEXT+=("")
fi

case $DSTATE in
    yes) TEXT+=("$(hdr "$C_BAD" banned)  $(paint "$C_BAD" yes)") ;;
    no) TEXT+=("$(hdr "$C_GOOD" banned)  $(paint "$C_GOOD" no)") ;;
    *) TEXT+=("$(hdr "$C_WARN" banned)  $(paint "$C_WARN" unknown)") ;;
esac

total=${#HEAD_LINES[@]}
[ "${#TEXT[@]}" -gt "$total" ] && total=${#TEXT[@]}

if [ "$total" -eq 0 ]; then
    exit 1
fi

if [ "${#HEAD_LINES[@]}" -eq 0 ]; then
    for line in "${TEXT[@]}"; do
        printf '%s\n' "$line"
    done
    exit 0
fi

for ((i = 0; i < total; i++)); do
    if [ "$i" -lt "${#HEAD_LINES[@]}" ]; then
        printf '%s' "${HEAD_LINES[i]}"
    else
        printf '%*s' "$HEAD_W" ''
    fi
    if [ "$i" -lt "${#TEXT[@]}" ]; then
        printf '  %s\n' "${TEXT[i]}"
    else
        printf '\n'
    fi
done

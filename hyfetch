    exit 0
fi

if [ "$mode" = cubelify ]; then
    case $cube_val in
        http://*|https://*) ;;
        *) die "invalid URL: $cube_val" ;;
    esac
    tmp=$(mktemp)
    jq --arg u "$cube_val" --arg n "$cube_nick" '
        .cubelify = (
            (.cubelify // []) as $c
            | (if ($c | type) == "string" then [$c] else $c end)
            | map(if type == "string" then {url: .} else . end)
            | map(select(.url != $u))
            | map(select($n == "" or ((.name // "") != $n)))
            | . + [if $n == "" then {url: $u} else {name: $n, url: $u} end]
            | sort_by((.name // "") + " " + .url)
        )' "$cfg_file" > "$tmp"
    mv "$tmp" "$cfg_file"
    printf 'saved %s\n' "${cube_nick:-$cube_val}"
    exit 0
fi

if [ "$mode" = cubelify_remove ]; then
    found=$(jq -r --arg t "$cube_rm" '
        (.cubelify // [])
        | (if type == "string" then [.] else . end)
        | map(if type == "string" then {url: .} else . end)
        | map(select(.url == $t or ((.name // "") == $t)))
        | length' "$cfg_file")
    [ "${found:-0}" -gt 0 ] || die "no such entry: $cube_rm"
    tmp=$(mktemp)

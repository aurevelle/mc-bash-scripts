player=

while [ "$#" -gt 0 ]; do
    case $1 in
        --key|--hypixel-key)
            mode=key
            [ "$#" -ge 2 ] || usage
            key_val=$2
            shift 2
            ;;
        --cubelify|--cubelify-url)
            mode=cubelify
            [ "$#" -ge 2 ] || usage
            cube_val=$2
            shift 2
            if [ "$#" -gt 0 ] && [ "${1#-}" = "$1" ]; then
                cube_nick=$1
                shift
            fi
            ;;
        --cubelify-remove|--remove-cubelify)
            mode=cubelify_remove
            [ "$#" -ge 2 ] || usage
            cube_rm=$2
            shift 2
            ;;
        --view-hidden)
            view_hidden=1
            shift
            ;;
        -h|--help)
            usage
            ;;
        --)
            shift
            break
            ;;
        -*)
            printf '%s: unknown option %s\n' "$prog" "$1" >&2
            usage
            ;;
        *)
            player=$1
            shift
            ;;
    esac
done

need_jq
ensure_config

if [ "$mode" = key ]; then
    [ -n "$key_val" ] || die "empty API key"
    tmp=$(mktemp)
